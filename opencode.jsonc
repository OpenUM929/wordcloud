{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "args": [
        "--browser", "chromium",
        "--headless",
        "--isolated",
        "--viewport-size", "1440x900",
        "--console-level", "warning",
        "--output-mode", "file",
        "--output-dir", "./wordcloud_project/plans/2026/0709_02_playwright-mcp-test/result/artifacts"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "playwright-headed": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "args": [
        "--browser", "chromium",
        "--isolated",
        "--viewport-size", "1440x900",
        "--console-level", "warning",
        "--output-mode", "file",
        "--output-dir", "./wordcloud_project/plans/2026/0709_02_playwright-mcp-test/result/artifacts"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
