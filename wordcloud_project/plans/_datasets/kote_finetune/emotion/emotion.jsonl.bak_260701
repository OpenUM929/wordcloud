{"id": "batch_20260624_0-332521", "text": "인격이 매우 훌륭하시며, 부서 직원들과 소통을 하였으면 함", "field": "단점", "sentiment_gold": "positive", "emotions_gold": ["hr_improvement_request"], "weak_sentiment": "positive", "applied_rule": "혼합: 칭찬어 동반 → polarity 재검", "label_source": "human", "review_status": "confirmed", "annotator": "human_review", "src_hash": null, "source_file": "group_needs_human_260624.jsonl", "promoted_at": "2026-06-30"}
