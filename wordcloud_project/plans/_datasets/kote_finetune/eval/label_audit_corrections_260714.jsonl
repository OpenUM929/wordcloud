{"action": "FIX", "slice": "8c_hard", "text": "공사현장, 안전컨설팅 등 현장 업무를 선호하며, 기타 업무에 대해서 수동적임", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "8c_hard", "text": "근태, 업무 처리 기간 및 시간관련", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "8c_hard", "text": "대내외 네크워크 보완", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "8c_hard", "text": "매사 업무적으로 구체적인 지시", "from": "positive", "to": "neutral", "pn": false}
{"action": "FIX", "slice": "8c_hard", "text": "보고 준비시 업무에 대하여 만전을 기해야함", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "8c_hard", "text": "비계량 지표를 계량해야 함", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "8c_hard", "text": "상하간의 업무조정능력", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "신속한 의사결정 바탕 업무", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "자기주관 뚜렷", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "적극적인 마인드와 폭넓은 지식", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "수평적 사고와 부드러운 리더쉽", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "부드러운 소통 리더십, 철저한 업무처리", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "민원인과의 소통 및 부드러운 카리스마", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "직원들 간 더 많은 의사소통", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "5직급에서 진급하여 기존에 친분이 있기에 더 편하게 업무에 관해 의논할수 있습니다", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "표현이 조금 오해를 불러일으킬수 있으나", "from": "negative", "to": "neutral", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "부드러운 리더십, 업무 전문성", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "업무에 대한 열의과다로 과다 업무지시", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "조금더 진솔한 대화를 하고싶다", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "회사의 어려운 상황속에서도 많이 수고하고 있습니다", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "소통을 좋아 하지만", "from": "positive", "to": "neutral", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "부하직원에 대한 신뢰", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "풍부한 경험, 적극적인 생활", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "신속한 업무처리 및 높은 전문성", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "업무가 많고 이슈가 다양한 만큼 선택과 집중할 수 있도록 조직을 이끌어 주시길 바람", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "약관, 제도 등의 해박한 지식과 업무에 대한 강한 책임감으로 문제를 해결하는데", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "솔선수범자세, 동료의식, 세심함", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "업무전문성 발휘한 업무", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "차장님으로서 어떠한 결정을 내리실때 믿고 따를수 있습니다", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "전문성을 높이기 위한 열의", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "자율적인 분위기 형성", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "baseline399", "text": "고객 니즈파악 및 소통", "from": "neutral", "to": "positive", "pn": false}
{"action": "FIX", "slice": "c3_neu149", "text": "세대간, 노사간 갈등", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "c3_neu149", "text": "메일함 좀 비웠으면 좋겠음", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "c3_neu149", "text": "인사이동이 늦어 업무 경험이 부족하여 시간이 필요", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "c3_neu149", "text": "아직 적응이 필요함", "from": "neutral", "to": "negative", "pn": false}
{"action": "FIX", "slice": "c3_neu149", "text": "매사 완벽을 추구하는 성품으로 &#46468;론 업무상 과도하게 완벽을 추구", "from": "negative", "to": "positive", "pn": true}
{"action": "FIX", "slice": "c3_neu149", "text": "너무 완벽한 업무처리 추구", "from": "negative", "to": "positive", "pn": true}
{"action": "FIX", "slice": "sa_speech74", "text": "대외적인 업무 진행에 있어서 수동적인 경향이 있으나 이는 과도한 행사성 업무를 자제하려는 것으로 보여짐", "from": "negative", "to": "neutral", "pn": false}
{"action": "FIX", "slice": "sa_speech74", "text": "개인적 감정에 치우침 /", "from": "neutral", "to": "negative", "pn": false}
